# Environment Variables

# Option 1: GitHub Models (FREE with GitHub Copilot)
# Get your token from: https://github.com/settings/tokens (classic token with no scopes needed)
# Or use: gh auth token (if you have GitHub CLI)
GITHUB_TOKEN="your_github_token_here"

# Option 2: OpenAI API Key (paid)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Server Port (optional)
PORT=5000
